{
  "name": "@browsync/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "package": "tsc && electron-builder --win",
    "package:dir": "tsc && electron-builder --dir"
  },
  "build": {
    "appId": "com.brosync.desktop",
    "productName": "BroSync Host",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@browsync/shared": "*",
    "dotenv": "^16.4.5",
    "socket.io-client": "^4.7.4",
    "uiohook-napi": "^1.5.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.3.3"
  }
}
